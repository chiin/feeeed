    {
      "id": "slovak_reading-2026-09-09-slovak-0028",
      "front": {
        "text": "Mami, po\u010fme na obed.",
        "audio": null,
        "image": null
      },
      "back": {
        "text": "Mom, let's go for lunch.",
        "notes": "[\u02c8p\u0254\u025fm\u025b]\n\npo\u010fme is the first-person plural imperative form of \u00eds\u0165, used to suggest that the speaker and listener go together."
      },
      "presentation": "text_reading",
      "available_at": "2026-09-11T16:00:00Z",
