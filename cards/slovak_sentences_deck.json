      "back": {
        "text": "He sent twelve letters.",
        "notes": "[\u02c8dvanas\u02d0t]\n\ndvan\u00e1s\u0165 is the cardinal number twelve, used here in the genitive plural to agree with listov (letters)."
      },
      "presentation": "text_reading",
