        "text": "Ja to viem.",
        "audio": null,
        "image": null
      },
      "back": {
        "text": "I know it.",
        "notes": "[ja]\n\nThe personal pronoun \u201cI\u201d in the nominative singular, used as the emphasized subject."
      },
      "presentation": "text_reading",
      "available_at": "2026-09-11T16:00:00Z",
