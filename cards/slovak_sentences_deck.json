    {
      "id": "slovak_reading-2026-09-08-slovak-0021",
      "front": {
        "text": "Slovenka Ana spravila na mieste konci knihy.",
        "audio": null,
        "image": null
      },
      "back": {
        "text": "The Slovak woman Ana finished the book at the place.",
        "notes": "Slovenka Ana spravila na mieste konci knihy\n\nSlovenka is the feminine singular noun indicating a woman of Slovenian origin, functioning as the subject of the sentence."
      },
      "presentation": "text_reading",
      "available_at": "2026-09-11T16:00:00Z",
      "scheduler_state": null,
      "schedule_previews": {
        "again": "10m",
