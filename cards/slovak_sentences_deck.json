      "front": {
        "text": "Slov\u00e1k \u0160tefan k\u013e\u00fa\u010dom otvoril dve vr\u00e1tania.",
        "audio": null,
        "image": null
      },
      "back": {
        "text": "The Slovak \u0160tefan opened two doors with a key.",
        "notes": "Slov\u00e1k \u0160tefan k\u013e\u00fa\u010dom otvoril dve vr\u00e1tania\n\nSlov\u00e1k is the nominative masculine singular noun denoting a person of Slovak ethnic origin, serving as the subject of the sentence."
      },
      "presentation": "text_reading",
