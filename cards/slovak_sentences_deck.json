    {
      "id": "slovak_reading-2026-09-08-slovak-0025",
      "front": {
        "text": "Angli\u010danka Lisa p\u00ed\u0161e \u010dl\u00e1nok pre \u010dasopis.",
        "audio": null,
        "image": null
      },
      "back": {
        "text": "The English woman Lisa writes an article for the magazine.",
        "notes": "Angli\u010danka Lisa p\u00ed\u0161e \u010dl\u00e1nok pre \u010dasopis\n\nAngli\u010danka is the feminine singular noun indicating a female national from the United Kingdom, functioning as the subject of the sentence."
      },
      "presentation": "text_reading",
