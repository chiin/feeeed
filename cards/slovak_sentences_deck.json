      "back": {
        "text": "Please say it once more.",
        "notes": "[\u02c8e\u0283te ra\u02d0s]\n\ne\u0161te raz is an adverbial phrase meaning once more or again, used here to request repetition of an action."
      },
      "presentation": "text_reading",
