        "text": "\u010cak\u00e1m vonku.",
        "audio": null,
        "image": null
      },
      "back": {
        "text": "I am waiting outside.",
        "notes": "[\u02c8v\u0254\u014bku]\n\nAn adverb of place meaning \u201coutside\u201d; it indicates where the waiting happens."
      },
      "presentation": "text_reading",
      "available_at": "2026-09-11T16:00:00Z",
      "scheduler_state": null,
