      "back": {
        "text": "He has eleven books.",
        "notes": "[\u02c8jed\u0259na\u02d0st]\n\njeden\u00e1s\u0165 is the cardinal number eleven, used here in the genitive plural after the verb m\u00e1 (has) to agree with kn\u00edh (books)."
      },
      "presentation": "text_reading",
      "available_at": "2026-09-06T16:00:00Z",
      "scheduler_state": null,
      "schedule_previews": {
