    {
      "id": "slovak_reading-2026-09-09-slovak-0027",
      "front": {
        "text": "Pozrite sa, tu je moja kniha.",
        "audio": null,
        "image": null
      },
      "back": {
        "text": "Look, here is my book.",
        "notes": "[tu j\u025b]\n\ntu je is a presentational phrase: tu means here, and je is the third-person singular present form of by\u0165, used to introduce something nearby."
      },
      "presentation": "text_reading",
      "available_at": "2026-09-11T16:00:00Z",
      "scheduler_state": {
