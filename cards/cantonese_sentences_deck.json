      "id": "cantonese_listening-2026-11-26-yue-0001",
      "front": {
        "text": "",
        "speak_cantonese": "\u4eba\u54cb\u90fd\u8d70\u6652\uff0c\u6211\u54cb\u4ef2\u55ba\u5ea6\u7b49\u3002",
        "audio": null,
        "image": null
      },
      "back": {
        "text": "\u4eba\u54cb\u90fd\u8d70\u6652\uff0c\u6211\u54cb\u4ef2\u55ba\u5ea6\u7b49\u3002",
        "notes": "Y\u00e0hn deih d\u014du j\u00e1u saai, ng\u00f3h deih juhng h\u00e1i douh d\u00e1ng.\n\nPeople have all left, but we are still waiting here.\n\n\u4eba\u54cb means \u201cpeople/others\u201d and functions as the subject of the sentence."
      },
      "presentation": "audio_only",
      "available_at": "2026-11-25T16:00:00Z",
      "scheduler_state": null,
      "schedule_previews": {
