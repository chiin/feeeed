    {
      "id": "cantonese_listening-2026-11-26-yue-0009",
      "front": {
        "text": "",
        "speak_cantonese": "\u6211\u53e3\u6e34\uff0c\u60f3\u98f2\u6c34\u3002",
        "audio": null,
        "image": null
      },
      "back": {
        "text": "I am thirsty and want to drink water.",
        "notes": "Ng\u00f3h h\u00e1u gok, s\u00e9ung y\u00e1m s\u00e9ui.\n\n\u6211\u53e3\u6e34\uff0c\u60f3\u98f2\u6c34\u3002\n\n\u98f2 is a transitive verb meaning \u201cto drink\u201d and takes \u6c34 as its object."
      },
      "presentation": "audio_only",
      "available_at": "2026-11-26T16:00:00Z",
      "scheduler_state": null,
