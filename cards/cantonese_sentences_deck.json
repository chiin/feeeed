    {
      "id": "cantonese_listening-2026-11-26-yue-0007",
      "front": {
        "text": "",
        "speak_cantonese": "\u4f60\u672c\u66f8\u653e\u5497\u55ba\u908a\u5ea6\uff1f",
        "audio": null,
        "image": null
      },
      "back": {
        "text": "Where did you put your book?",
        "notes": "N\u00e9ih b\u00fan sy\u016b fong j\u00f3 h\u00e1i b\u012bn douh?\n\n\u4f60\u672c\u66f8\u653e\u5497\u55ba\u908a\u5ea6\uff1f\n\n\u908a\u5ea6 is an interrogative locative meaning \u201cwhere\u201d and follows the preposition \u55ba."
      },
      "presentation": "audio_only",
      "available_at": "2026-11-26T16:00:00Z",
      "scheduler_state": null,
