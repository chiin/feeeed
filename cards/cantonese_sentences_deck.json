      "front": {
        "text": "",
        "speak_cantonese": "\u4f62\u591c\u665a\u505a\u5de5\uff0c\u664f\u665d\u7793\u89ba\u3002",
        "audio": null,
        "image": null
      },
      "back": {
        "text": "\u4f62\u591c\u665a\u505a\u5de5\uff0c\u664f\u665d\u7793\u89ba\u3002",
        "notes": "K\u00e9uih jeh m\u00e1ahn juhk g\u016bng, ngaam jauh fan gaau.\n\nHe works at night and sleeps in the afternoon.\n\n\u505a\u5de5 is a verb phrase meaning \u201cto work/do a job\u201d and is the main predicate."
      },
      "presentation": "audio_only",
      "available_at": "2026-11-25T16:00:00Z",
      "scheduler_state": null,
