      "front": {
        "text": "",
        "speak_cantonese": "\u6211\u53e3\u6e34\uff0c\u60f3\u98f2\u6c34\u3002",
        "audio": null,
        "image": null
      },
      "back": {
        "text": "\u6211\u53e3\u6e34\uff0c\u60f3\u98f2\u6c34\u3002",
        "notes": "Ng\u00f3h h\u00e1u gok, s\u00e9ung y\u00e1m s\u00e9ui.\n\nI am thirsty and want to drink water.\n\n\u98f2 is a transitive verb meaning \u201cto drink\u201d and takes \u6c34 as its object."
      },
      "presentation": "audio_only",
      "available_at": "2026-11-25T16:00:00Z",
