    {
      "id": "mandarin_reading-2026-09-06-hsk-0151",
      "front": {
        "text": "\u8acb\u4f60\u628a\u9019\u672c\u66f8\u653e\u5728\u684c\u5b50\u4e0a\u5427\u3002",
        "audio": null,
        "image": null
      },
      "back": {
        "text": "Please put this book on the table.",
        "notes": "Q\u01d0ng n\u01d0 b\u01ce zh\u00e8 b\u011bn sh\u016b f\u00e0ng z\u00e0i zhu\u014dzi sh\u00e0ng ba.\n\n\u5427 (ba) - modal particle used to make a polite suggestion"
      },
      "available_at": "2026-09-05T17:24:00.504659Z",
      "scheduler_state": null,
      "schedule_previews": {
