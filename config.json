{
  "streams": {
    "hsk": {
      "type": "anki_deck",
      "source_type": "csv",
      "path": "HSK.csv",
      "feed_title": "HSK Vocabulary",
      "new_cards_per_day": 50,
      "front_text_scale": 2,
      "practice_export": {
        "path": "hsk_practice.csv",
        "minimum_interval_days": 30
      }
    },
    "economics": {
      "type": "pdf_folder",
      "folder": "Economics_Cards",
      "strategy": "sequential",
      "batch_size": 5,
      "feed_title": "Daily Economics Reading"
    },
    "politics": {
      "type": "pdf_folder",
      "folder": "Politics_Cards",
      "strategy": "random_without_replacement",
      "batch_size": 5,
      "feed_title": "Random Politics Insights"
    },
    "philosophy": {
      "type": "pdf_folder",
      "folder": "Philosophy_Cards",
      "strategy": "random_with_replacement",
      "batch_size": 5,
      "feed_title": "Random Philosophy Reading"
    },
    "architecture": {
      "type": "pdf_folder",
      "folder": "Architecture_Cards",
      "strategy": "random_with_replacement",
      "batch_size": 5,
      "feed_title": "Architecture Cards"
    },
    "art_history": {
      "type": "pdf_folder",
      "folder": "Art_History_Cards",
      "strategy": "random_with_replacement",
      "batch_size": 5,
      "feed_title": "Art History Cards"
    },
    "current_book": {
      "type": "current_book",
      "book_id": "the_jazz_scene",
      "folder": "Book_1_Cards",
      "feed_title": "Current Book"
    },
    "current_book_2": {
      "type": "current_book",
      "book_id": "china_next_global_order",
      "folder": "Book_2_Cards",
      "feed_title": "Current Book 2"
    },
    "mandarin_sentences": {
      "type": "anki_deck",
      "source_type": "generated_sentences",
      "program_id": "mandarin_reading",
      "path": "generated/mandarin_reading/sentences.json",
      "feed_title": "Mandarin Sentence Practice",
      "new_cards_per_day": 10,
      "front_text_scale": 1.5
    },
    "slovak_vocab": {
      "type": "anki_deck",
      "source_type": "csv",
      "path": "Slovak.csv",
      "feed_title": "Slovak Vocabulary",
      "new_cards_per_day": 20,
      "front_text_scale": 1.5
    },
    "slovak_sentences": {
      "type": "anki_deck",
      "source_type": "generated_sentences",
      "program_id": "slovak_reading",
      "path": "generated/slovak_reading/sentences.json",
      "feed_title": "Slovak Sentence Practice",
      "new_cards_per_day": 10,
      "front_text_scale": 1.2
    }
  },
  "programs": {
    "mandarin_reading": {
      "enabled": true,
      "feed_title": "Mandarin Vocabulary and Sentences",
      "feed_file": "mandarin.xml",
      "source_stream": "hsk",
      "sentence_stream": "mandarin_sentences",
      "content_path": "generated/mandarin_reading/sentences.json",
      "vocabulary_introduction": {
        "strategy": "vocabulary_first"
      },
      "sentence_generation": {
        "trigger": "after_first_passing_vocabulary_review",
        "minimum_passing_reviews": 1,
        "allow_inflected_targets": false
      },
      "language_code": "zh-CN",
      "orthography": "Traditional Chinese",
      "transliteration_style": "Hanyu Pinyin with tone marks",
      "mode": "text_reading",
      "prompt_style": "formal written Mandarin",
      "promotion_threshold_sentence_passes": 3,
      "max_active_word_buffer": 30,
      "daily_sentence_target": 10,
      "mastery_interval_days": 21,
      "known_pool_limit": 200,
      "sentence_lifecycle": "disposable_scaffold",
      "generation": {
        "provider": "openrouter",
        "model": "openrouter/free",
        "api_key_env": "OPENROUTER_API_KEY",
        "timeout_seconds": 90
      }
    },
    "slovak_reading": {
      "enabled": true,
      "feed_title": "Slovak Vocabulary and Sentences",
      "feed_file": "slovak.xml",
      "source_stream": "slovak_vocab",
      "sentence_stream": "slovak_sentences",
      "content_path": "generated/slovak_reading/sentences.json",
      "vocabulary_introduction": {
        "strategy": "vocabulary_first"
      },
      "prior_knowledge": {
        "source_catalog": "assumed_familiar"
      },
      "sentence_generation": {
        "trigger": "catalog_order",
        "minimum_passing_reviews": 1,
        "allow_inflected_targets": true,
        "familiar_pool_policy": "natural_priority",
        "context_pool": "source_catalog"
      },
      "vocabulary_discovery": {
        "enabled": true,
        "approval": "manual"
      },
      "language_code": "sk-SK",
      "orthography": "Standard Slovak using the Slovak Latin alphabet",
      "transliteration_style": "IPA for the target occurrence",
      "mode": "text_reading",
      "prompt_style": "natural contemporary Slovak",
      "promotion_threshold_sentence_passes": 3,
      "max_active_word_buffer": 30,
      "daily_sentence_target": 10,
      "mastery_interval_days": 21,
      "known_pool_limit": 200,
      "sentence_lifecycle": "disposable_scaffold",
      "generation": {
        "provider": "openrouter",
        "model": "openrouter/free",
        "api_key_env": "OPENROUTER_API_KEY",
        "timeout_seconds": 90,
        "quality_version": 2,
        "max_attempts": 3
      }
    }
  }
}
