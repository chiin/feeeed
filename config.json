{
  "streams": {
    "hsk": {
      "type": "anki_deck",
      "source_type": "csv",
      "path": "HSK.csv",
      "feed_title": "HSK Vocabulary",
      "new_cards_per_day": 50,
      "front_text_scale": 2
    },
    "economics": {
      "type": "pdf_folder",
      "folder": "Economics_Cards",
      "strategy": "sequential",
      "batch_size": 5,
      "feed_title": "Daily Economics Reading"
    },
    "politics": {
      "type": "pdf_folder",
      "folder": "Politics_Cards",
      "strategy": "random_without_replacement",
      "batch_size": 5,
      "feed_title": "Random Politics Insights"
    },
    "philosophy": {
      "type": "pdf_folder",
      "folder": "Philosophy_Cards",
      "strategy": "random_with_replacement",
      "batch_size": 5,
      "feed_title": "Random Philosophy Reading"
    },
    "architecture": {
      "type": "pdf_folder",
      "folder": "Architecture_Cards",
      "strategy": "random_with_replacement",
      "batch_size": 5,
      "feed_title": "Architecture Cards"
    },
    "art_history": {
      "type": "pdf_folder",
      "folder": "Art_History_Cards",
      "strategy": "random_with_replacement",
      "batch_size": 5,
      "feed_title": "Art History Cards"
    },
    "current_book": {
      "type": "current_book",
      "book_id": "the_jazz_scene",
      "folder": "Book_1_Cards",
      "feed_title": "Current Book"
    },
    "current_book_2": {
      "type": "current_book",
      "book_id": "china_next_global_order",
      "folder": "Book_2_Cards",
      "feed_title": "Current Book 2"
    },
    "mandarin_sentences": {
      "type": "anki_deck",
      "source_type": "generated_sentences",
      "program_id": "mandarin_reading",
      "path": "generated/mandarin_reading/sentences.json",
      "feed_title": "Mandarin Sentence Practice",
      "new_cards_per_day": 10,
      "front_text_scale": 1.5
    }
  },
  "programs": {
    "mandarin_reading": {
      "enabled": true,
      "source_stream": "hsk",
      "sentence_stream": "mandarin_sentences",
      "content_path": "generated/mandarin_reading/sentences.json",
      "control_source_new_cards": true,
      "language_code": "zh-CN",
      "orthography": "Traditional Chinese",
      "mode": "text_reading",
      "prompt_style": "formal written Mandarin",
      "promotion_threshold_sentence_passes": 3,
      "max_active_word_buffer": 30,
      "daily_sentence_target": 10,
      "mastery_interval_days": 21,
      "familiar_min_reviews": 1,
      "known_pool_limit": 200,
      "sentence_lifecycle": "disposable_scaffold",
      "generation": {
        "provider": "openrouter",
        "model": "qwen/qwen3-30b-a3b-instruct-2507",
        "api_key_env": "OPENROUTER_API_KEY",
        "timeout_seconds": 90
      }
    }
  }
}
